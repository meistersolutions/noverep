# Database
POSTGRES_USER=noverep
POSTGRES_PASSWORD=noverep_secret
POSTGRES_DB=noverep
DATABASE_URL=postgresql+asyncpg://noverep:noverep_secret@db:5432/noverep

# Redis
REDIS_URL=redis://redis:6379/0

# Backend
SECRET_KEY=change-me-to-a-long-random-string-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=365
# Deprecated: use JWT_ACCESS_EXPIRE_MINUTES instead
JWT_EXPIRE_MINUTES=10080
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,capacitor://localhost,https://localhost

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# YouTube Data API (optional – yt-dlp fallback when unset)
YOUTUBE_API_KEY=

# Required for Android background audio on cloud hosts (Render): Netscape cookies.txt
# Export while logged into YouTube (incognito + extension "Get cookies.txt LOCALLY"),
# then paste file contents into YOUTUBE_COOKIES, or base64 into YOUTUBE_COOKIES_B64.
# YOUTUBE_COOKIES=
# YOUTUBE_COOKIES_B64=
# YOUTUBE_COOKIES_FILE=/path/to/cookies.txt

# Spotify (future)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Frontend – use /api/v1 for Docker/mobile (nginx proxies to backend)
# For local npm dev only, use: http://localhost:8000/api/v1
VITE_API_URL=/api/v1

# CORS – add your LAN IP when accessing from phone, e.g.:
# CORS_ORIGINS=http://localhost:5173,http://192.168.1.100:5173,capacitor://localhost,https://localhost

# YouTube – NOT required (uses yt-dlp). Optional if you add YouTube Data API later:
YOUTUBE_API_KEY=

# Songs Library (standalone catalog that feeds NoRepeat discovery)
# SONGS_LIBRARY_URL=http://127.0.0.1:8100
# SONGS_LIBRARY_ENABLED=true
