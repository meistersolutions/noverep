# Production API URL for Capacitor builds (baked in at build time).
# Copy to .env.production.local before: npm run build:capacitor
VITE_API_URL=https://noverep-api.onrender.com/api/v1

# Optional: Songs Library root health URL (mobile keepalive pings this too)
# VITE_SONGS_LIBRARY_URL=https://songs-library.onrender.com/health

# LAN dev example (phone + docker on same Wi-Fi):
# VITE_API_URL=http://192.168.1.42:8000/api/v1
