# Copy to keystore.properties (gitignored) and fill in values.
# Generate a keystore once, then keep this file + the .keystore backed up forever.
#
# keytool -genkeypair -v -storetype PKCS12 \
#   -keystore noverep-release.keystore -alias noverep \
#   -keyalg RSA -keysize 2048 -validity 10000

storeFile=noverep-release.keystore
storePassword=CHANGE_ME
keyAlias=noverep
keyPassword=CHANGE_ME
