{
  "name": "noverep-frontend",
  "private": true,
  "version": "1.6.7",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:capacitor": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint .",
    "cap:sync": "node scripts/sync-app-version.mjs && npm run build:capacitor && npx cap sync && node scripts/patch-native-background.mjs",
    "cap:android": "npx cap open android",
    "cap:ios": "npx cap open ios",
    "cap:run:android": "npm run cap:sync && npx cap run android",
    "cap:apk": "npm run cap:sync && cd android && .\\gradlew.bat assembleDebug",
    "cap:deploy:android": "node scripts/deploy-android.mjs",
    "cap:deploy:android:win": "powershell -ExecutionPolicy Bypass -File scripts/deploy-android.ps1",
    "cap:check-java": "powershell -ExecutionPolicy Bypass -File scripts/ensure-java-home.ps1",
    "cap:release": "npm run cap:sync && cd android && .\\gradlew.bat assembleRelease",
    "cap:aab": "npm run cap:sync && cd android && .\\gradlew.bat bundleRelease",
    "cap:patch-native": "node scripts/patch-native-background.mjs",
    "version:sync": "node scripts/sync-app-version.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "@capacitor/preferences": "^7.0.4",
    "@capacitor/splash-screen": "^7.0.0",
    "@capacitor/status-bar": "^7.0.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.4.1",
    "react-router-dom": "^6.28.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  }
}
